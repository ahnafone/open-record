# Open Record public HTTPS reverse proxy (Caddy 2.8+).
#
# Traffic path:
#   internet -> router TCP 80/443 -> this host (10.0.0.139)
#            -> Caddy -> 127.0.0.1:8787 (Open Record, systemd user unit)
#
# Caddy is the ONLY public listener. The app's port 8787 must never be
# port-forwarded; ufw allows it only from the home LAN so phones and Cast
# speakers can reach the server directly.
#
# Why "bind": Tailscale Serve already owns 127.0.0.1:80 and 127.0.0.1:443 on
# this machine. Binding the wildcard (:80/:443) would collide with it, so Caddy
# binds only the LAN address that the router forwards to. Automatic HTTPS still
# gets a normal Let's Encrypt certificate: the router's TCP 80/443 forwards
# carry the HTTP-01 and TLS-ALPN-01 challenges. If the DHCP reservation or LAN
# address changes, update this file as well as the reservation.
#
# Install (full runbook in deploy/README.md):
#   sudo install -m 0644 deploy/Caddyfile /etc/caddy/Caddyfile
#   sudo caddy fmt --overwrite /etc/caddy/Caddyfile
#   sudo caddy validate --config /etc/caddy/Caddyfile --adapter caddyfile
#   sudo systemctl reload caddy
#
# Optional ACME account email. Global options must be the first block in the
# file; uncomment and set a real address if you want expiry notices:
# {
# 	email you@example.com
# }

open-record.uttarasoftware.ca {
	# Bind the LAN address, not 0.0.0.0. See the Tailscale note above.
	bind 10.0.0.139

	# A hostname site address turns on automatic HTTPS (Let's Encrypt, with
	# ZeroSSL as the default fallback CA). Keep TLS 1.2 as the floor; 1.3 is
	# negotiated whenever the client supports it.
	tls {
		protocols tls1.2 tls1.3
	}

	# The app caps uploads at 200 MB (CAST_UPLOAD_MAX_MB). This is headroom for
	# multipart framing, not a second size policy.
	request_body {
		max_size 220MB
	}

	header {
		Strict-Transport-Security "max-age=86400"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(self)"
		# Do not advertise the server software.
		-Server
	}

	# /session is a WebSocket and /cast/relay streams audio, so responses must
	# not be buffered: flush_interval -1. WebSocket upgrades are proxied
	# automatically; no extra Upgrade headers are needed here.
	#
	# X-Forwarded-For: Caddy appends the real peer address to any client-supplied
	# header. Fastify trusts that header only when it arrives from 127.0.0.1
	# (TRUST_PROXY=127.0.0.1), so a LAN client cannot spoof its address.
	reverse_proxy 127.0.0.1:8787 {
		flush_interval -1
	}

	# Access logging is intentionally OFF. /cast/relay/<token> is a bearer
	# credential in the URL, and an access log would write it to disk. The app's
	# own request logging redacts relay URLs, but Caddy access logs would not.
	#
	# If you ever enable access logging, Caddy 2.8 renamed the old skip_log
	# directive to log_skip. Add ALL THREE lines below (site block, not inside a
	# log block), and keep the matcher exact:
	#
	#   log
	#   @relay path /cast/relay/*
	#   log_skip @relay
	#
	# Do not add a bare "log" without the skip: it will record relay tokens.
}

# Explicit HTTP site. Without it, Caddy's automatic HTTP->HTTPS redirect server
# binds the wildcard :80 and collides with Tailscale's 127.0.0.1:80. Binding
# the forwarded LAN address here keeps both listeners separate. The redirect
# is intentionally a plain 301; Caddy still solves the TLS-ALPN-01 challenge
# on :443 if the HTTP-01 challenge is unavailable.
http://open-record.uttarasoftware.ca {
	bind 10.0.0.139
	redir https://{host}{uri} permanent
}
