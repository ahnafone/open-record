{
  "name": "@open-record/source",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "start": "nx serve app",
    "build": "nx build app",
    "lint": "nx run-many -t lint",
    "typecheck": "nx run-many -t typecheck",
    "test": "nx run-many -t test",
    "check": "npm run tokens:check && nx run-many -t lint typecheck build",
    "tokens": "node tools/gen-tokens/gen-tokens.mjs",
    "tokens:check": "node tools/gen-tokens/gen-tokens.mjs --check",
    "assets:app": "node apps/app/resources/generate-sources.mjs && cd apps/app && capacitor-assets generate --android --ios --iconBackgroundColor '#171b20' --iconBackgroundColorDark '#171b20' --splashBackgroundColor '#171b20' --splashBackgroundColorDark '#171b20'",
    "cap:sync": "nx run app:cap-sync",
    "server:up": "node scripts/server-up.mjs",
    "server:start": "node scripts/server-up.mjs",
    "server:stop": "node scripts/server-up.mjs --stop",
    "server:dev": "nx serve server",
    "android": "nx run app:cap-sync && cd apps/app && cap run android",
    "android:open": "nx run app:cap-sync && cd apps/app && cap open android",
    "android:release": "npm run cap:sync && cd apps/app/android && ./gradlew assembleRelease",
    "android:release:install": "npm run android:release && adb install -r apps/app/android/app/build/outputs/apk/release/app-release.apk",
    "ios": "npm run cap:sync && cd apps/app && cap run ios",
    "ios:open": "npm run cap:sync && cd apps/app && cap open ios",
    "ios:release": "npm run cap:sync && cd apps/app/ios/App && xcodebuild -project App.xcodeproj -scheme App -configuration Release -destination generic/platform=iOS -derivedDataPath build build"
  },
  "private": true,
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "~2.7.3",
    "@analogjs/vitest-angular": "~2.7.3",
    "@angular-devkit/core": "~22.2.0",
    "@angular-devkit/schematics": "~22.2.0",
    "@angular/build": "~22.2.0",
    "@angular/cli": "~22.2.0",
    "@angular/compiler-cli": "~22.2.0",
    "@angular/language-service": "~22.2.0",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.3",
    "@eslint/js": "^9.8.0",
    "@nx/angular": "^24.0.0",
    "@nx/eslint": "^24.0.0",
    "@nx/eslint-plugin": "^24.0.0",
    "@nx/js": "24.0.0",
    "@nx/vitest": "24.0.0",
    "@nx/web": "24.0.0",
    "@nx/workspace": "^24.0.0",
    "@oxc-project/runtime": "^0.115.0",
    "@schematics/angular": "~22.2.0",
    "@swc-node/register": "1.11.1",
    "@swc/core": "1.15.8",
    "@swc/helpers": "0.5.18",
    "@types/node": "^24.0.0",
    "@types/qrcode": "^1.5.6",
    "@typescript-eslint/utils": "^8.58.0",
    "@vitest/coverage-v8": "^4.0.0",
    "@vitest/ui": "^4.0.0",
    "angular-eslint": "^22.5.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^10.0.0",
    "fake-indexeddb": "^6.2.6",
    "jsdom": "^27.1.0",
    "nx": "24.0.0",
    "prettier": "^3.8.1",
    "tslib": "^2.3.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.0.0",
    "vitest": "^4.0.0",
    "yaml": "^2.9.1"
  },
  "packageManager": "npm@11.6.2",
  "dependencies": {
    "@angular/common": "~22.2.0",
    "@angular/compiler": "~22.2.0",
    "@angular/core": "~22.2.0",
    "@angular/forms": "~22.2.0",
    "@angular/platform-browser": "~22.2.0",
    "@angular/router": "~22.2.0",
    "@capacitor-community/sqlite": "^8.1.1",
    "@capacitor-mlkit/barcode-scanning": "^8.2.1",
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/network": "8.0.1",
    "@capacitor/preferences": "8.0.1",
    "@capawesome/capacitor-file-picker": "^8.1.1",
    "@fastify/cors": "^11.3.1",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/static": "10.1.6",
    "@supabase/supabase-js": "2.117.3",
    "capacitor-plugin-playlist": "^8.0.0",
    "fastify": "^5.12.7",
    "idb": "^8.0.4",
    "jose": "6.2.12",
    "jsqr": "1.4.0",
    "music-metadata": "^12.3.0",
    "qrcode": "^1.5.4",
    "rxjs": "~7.8.0"
  }
}
