# Edge Functions secrets template. Copy to supabase/functions/.env for local
# `supabase functions serve`, or push to a hosted project with:
#   npx supabase secrets set --env-file supabase/functions/.env
# Never commit the real .env (ignored by supabase/functions/.gitignore).
#
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are provided automatically to
# Edge Functions; do not set them here (`supabase secrets set` rejects SUPABASE_*
# names on hosted projects).

# Auth user id (UUID) of the single admin account. Dashboard > Authentication >
# Users > copy the UID of the admin user you created by hand.
ADMIN_USER_ID=

# Where new-request and admin notifications are sent.
ADMIN_EMAIL=

# Recommended. Random secret used to salt the hashed source IP stored with each
# access request (throttling only; the raw IP is never stored). Generate with:
#   openssl rand -hex 32
# Leave empty to fall back to a fixed label, which is weaker.
REQUEST_IP_SALT=

# Resend API key (Resend dashboard > API Keys, sending access is enough).
RESEND_API_KEY=

# Sender for all mail, on a domain verified in Resend, e.g.
# Open Record <access@open-record.example.com>
MAIL_FROM=

# Public web app URL: invite/redirect target and links in mail. Must match the
# Supabase Auth Site URL and redirect allow-list. e.g. https://open-record.example.com
PUBLIC_APP_URL=
