{
  "name": "provider-remote",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/providers/remote/src",
  "projectType": "library",
  "tags": [
    "type:provider"
  ],
  "// targets": "to see all targets run: nx show project provider-remote --web",
