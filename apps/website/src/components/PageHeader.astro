---
import { url } from '../lib/site';

interface Props {
  title: string;
  lead?: string;
}

const { title, lead } = Astro.props;
---

<header class="page-hero">
  <nav class="breadcrumb" aria-label="Breadcrumb">
    <a href={url()}>Open Record</a> <span aria-hidden="true">/</span> <span aria-current="page">{title}</span>
  </nav>
  <h1>{title}</h1>
  {lead && <p class="lead">{lead}</p>}
</header>
