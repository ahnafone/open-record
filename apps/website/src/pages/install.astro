---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import DownloadCard from '../components/DownloadCard.astro';
import { DOWNLOADS, IPHONE_GUIDE_URL, RELEASES_URL, INSTALL_GUIDE_URL, WEB_APP_URL, url } from '../lib/site';
---

<Layout
  title="Install"
  path="install/"
  description="Install Open Record v0.0.1 beta: Linux, Windows and macOS installers (unsigned), the Android APK, and building for iPhone from source."
>
  <div class="container">
    <PageHeader
      title="Install"
      lead="Beta · v0.0.1. Pick the file for your system. Desktop installers are unsigned and do not auto-update; Android is beta-tested; iPhone is build-from-source and untested."
    />

    <div class="page-body">
      <section aria-labelledby="desktop-installs">
        <h2 id="desktop-installs">Desktop</h2>
        <p class="muted">
          Get the file from the <a href={RELEASES_URL} rel="noopener">latest release</a>. To update, install the newer
          file over the old one; your data folder is kept.
        </p>
        <div class="grid grid--2 grid--3">
          <DownloadCard
            title="Linux x64 · .deb"
            file="OpenRecord-linux-amd64.deb"
            href={DOWNLOADS.linuxDeb}
            tags={[{ label: 'Recommended', variant: 'primary' }]}
            note="The primary Linux install on Ubuntu 24.04. Adds the launcher entry."
            command="sudo apt install ./OpenRecord-linux-amd64.deb"
            external
          />
          <DownloadCard
            title="Linux x64 · AppImage"
            file="OpenRecord-linux-x86_64.AppImage"
            href={DOWNLOADS.linuxAppImage}
            tags={[{ label: 'Portable' }]}
            note="Run chmod +x, then start it. If it reports libfuse.so.2, install libfuse2t64 (libfuse2 on 22.04). If AppArmor blocks Chromium's sandbox, use the .deb."
            external
          />
          <DownloadCard
            title="Windows x64 · .exe"
            file="OpenRecord-windows-x64.exe"
            href={DOWNLOADS.windows}
            tags={[{ label: 'Unsigned', variant: 'primary' }]}
            note="SmartScreen says Windows protected your PC: choose More info, then Run anyway. Defender may scan the bundled binaries on first launch."
            external
          />
          <DownloadCard
            title="macOS · Apple Silicon"
            file="OpenRecord-macos-arm64.dmg"
            href={DOWNLOADS.macArm}
            tags={[{ label: 'Unsigned', variant: 'primary' }]}
            note="Open the DMG and drag Open Record to Applications. The first time, right-click it and choose Open. If macOS says the app is damaged, clear quarantine as described on the Desktop page."
            external
          />
          <DownloadCard
            title="macOS · Intel"
            file="OpenRecord-macos-x64.dmg"
            href={DOWNLOADS.macIntel}
            tags={[{ label: 'Unsigned', variant: 'primary' }]}
            note="Same steps as Apple Silicon, with the Intel DMG."
            external
          />
        </div>
        <p class="meta">
          Desktop details, data folders and troubleshooting: <a href={url('desktop/')}>the desktop guide</a>.
        </p>
      </section>

      <section aria-labelledby="android-install">
        <h2 id="android-install">Android</h2>
        <div class="grid grid--2">
          <DownloadCard
            title="Android · APK"
            file="OpenRecord-android.apk"
            href={DOWNLOADS.android}
            tags={[{ label: 'Beta-tested', variant: 'ivory' }, { label: 'Sideload' }]}
            note="Android 7 or newer. Open the downloaded APK and allow installs from your browser or file manager when asked. It is not on Google Play."
            external
          />
        </div>
        <ol class="prose">
          <li>Download the APK on the phone, or copy it there.</li>
          <li>Open it and allow the install from that app when Android asks.</li>
          <li>Update by installing the new APK over the old one. It only updates in place when signed with the same key; uninstalling deletes downloads and local library data.</li>
        </ol>
      </section>

      <section aria-labelledby="iphone-install">
        <h2 id="iphone-install">iPhone</h2>
        <p class="prose">
          There is no prebuilt iPhone download. Build from source on a Mac with Xcode and a free Apple ID. The build
          expires after 7 days; re-run it from Xcode to re-sign. There is no App Store or TestFlight build.
        </p>
        <div class="card__actions">
          <a class="button button--primary" href={url('iphone/')}>iPhone guide</a>
          <a class="button" href={IPHONE_GUIDE_URL} rel="noopener">Build guide on GitHub</a>
        </div>
      </section>

      <section aria-labelledby="web-install">
        <h2 id="web-install">Web app</h2>
        <p class="prose">
          Nothing to install. The hosted web app runs in the browser, with limits for guests and accounts for your
          library. <a href={url('web/')}>How the web app works</a>, or open it directly at
          <a href={WEB_APP_URL} rel="noopener">{WEB_APP_URL.replace('https://', '')}</a>.
        </p>
      </section>

      <section aria-labelledby="source-install">
        <h2 id="source-install">Run from source</h2>
        <p class="prose">
          Developers can build and run the app from the repository with Node 24. See the
          <a href={INSTALL_GUIDE_URL} rel="noopener">install and run section of the README</a>.
        </p>
      </section>
    </div>
  </div>
</Layout>
