---
import { getEntry, render } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import { DESKTOP_GUIDE_URL, RELEASES_URL, url } from '../lib/site';

// The guide is rendered from docs/desktop.md at build time, so the repo stays the single source.
const entry = await getEntry('desktop', 'desktop');
const rendered = entry ? await render(entry) : null;
---

<Layout
  title="Desktop app"
  path="desktop/"
  description="Open Record for desktop: offline catalogue and local imports, a bundled local server, optional phone access on your Wi-Fi, and unsigned installers."
>
  <div class="container">
    <PageHeader
      title="Desktop app"
      lead="One Electron app for Windows and Linux; macOS builds from source for now. It bundles the web UI, the local server, yt-dlp and ffmpeg. The installers are unsigned, and there is no auto-update."
    />

    <div class="page-body">
      <section aria-labelledby="desktop-summary">
        <h2 id="desktop-summary">At a glance</h2>
        <ul class="rule-list">
          <li>Works offline for the bundled catalogue, local imports, playback, playlists, history and settings.</li>
          <li>Search, streaming and saving need the internet and yt-dlp; sync needs your own Supabase project.</li>
          <li>The local address is fixed at <code>http://127.0.0.1:47900</code>; a taken port reports an error instead of changing.</li>
          <li>"Allow phones on this network" exposes the server on your LAN over plain HTTP. Trusted Wi-Fi only.</li>
        </ul>
        <div class="card__actions">
          <a class="button button--primary" href={`${url()}#downloads`}>Download the desktop app</a>
          <a class="button button--ghost" href={RELEASES_URL} rel="noopener">Release notes</a>
        </div>
      </section>

      {
        rendered ? (
          <section class="docs" aria-label="Full desktop guide">
            <rendered.Content />
          </section>
        ) : (
          <section aria-labelledby="guide-fallback">
            <h2 id="guide-fallback">Full guide</h2>
            <p class="prose">
              The full install, Supabase and troubleshooting guide is on GitHub.
            </p>
            <div class="card__actions">
              <a class="button" href={DESKTOP_GUIDE_URL} rel="noopener">Desktop guide on GitHub</a>
            </div>
          </section>
        )
      }
    </div>
  </div>
</Layout>
