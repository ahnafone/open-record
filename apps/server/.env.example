# Open Record server environment template.
# Copy to apps/server/.env and chmod 600. That file is private; never commit it.
#
# NEVER put the Supabase database password in this file (or anywhere in this
# repo): the server never needs it. The secrets that belong here are the bearer
# token, the legacy HS256 Supabase JWT secret, and, only in public mode
# (REQUIRE_APPROVAL=true), the Supabase service_role key. The Supabase anon key
# is public by design. Never commit this file.
#
# Public deployment (Cloudflare Tunnel + systemd user unit): docs/public-hosting.md.

# Optional. Leave unset to have the server generate a token and save it to
# ~/.config/open-record/token (mode 0600). To choose your own, set a long random
# value (16+ characters), e.g. from: openssl rand -hex 32
# OPEN_RECORD_TOKEN=<paste a long random value here>
# Where the token, cast secret and upload cache live; server:up also keeps
# server.pid and server.log here. Absolute path: "~" is not expanded.
# Defaults to ~/.config/open-record.
# OPEN_RECORD_DATA_DIR=/home/you/.config/open-record
PORT=8787
# Listen interface. Public server: 127.0.0.1, so cloudflared is the only way in
# (docs/public-hosting.md). LAN phones and Cast speakers need the LAN address or 0.0.0.0.
# Never port-forward 8787.
HOST=0.0.0.0
# Optional: serve a built web app at / with SPA fallback from this host path
# (e.g. dist/apps/app/browser). Unset = API only. The systemd unit sets this.
# WEB_DIR=dist/apps/app/browser
# Requests per minute per user, or per IP for the static token and public routes (app-wide). Invalid bearer tokens have a separate limit of 30 a minute per IP, then 429; missing headers and expired JWTs are not counted there. 600 keeps 1 s polling from being throttled.
# RATE_LIMIT_MAX=600
# MAX_CONCURRENT_RESOLVES=2
# STREAM_CACHE_TTL=1800
# RESOLVE_RATE_LIMIT_MAX=30

# --- Public server (docs/public-hosting.md) ----------------------------------
# Public mode (Cloudflare Tunnel + admin approval): docs/public-hosting.md and
# apps/server/README.md "Public mode". Leave REQUIRE_APPROVAL unset elsewhere.
# REQUIRE_APPROVAL=true
# Server-side only, for the approval lookup. Bypasses RLS: never commit it, never
# give it to the web or desktop app. Required with REQUIRE_APPROVAL=true.
# SUPABASE_SERVICE_ROLE_KEY=
# Supabase user id (UUID) of the admin, always allowed without an approved request.
# ADMIN_USER_ID=
# Public Cloudflare Turnstile site key, served at GET /app-config. Not a secret.
# TURNSTILE_SITE_KEY=
# Guest streaming: signed-out visitors may use /search, /resolve and /stream (default off).
# Guests never get the cookies.txt retry; only signed-in callers do.
# GUEST_STREAMING=false
# Per-client guest requests per minute and per day (shared by the three routes).
# GUEST_STREAM_PER_MINUTE=10
# GUEST_STREAM_PER_DAY=100
# Guest requests per minute across all clients combined (bounds many-address evasion).
# GUEST_GLOBAL_PER_MINUTE=60
# yt-dlp processes guests may run at once (1-16). Never the last MAX_CONCURRENT_RESOLVES slot.
# GUEST_MAX_CONCURRENT=1
# Hosts guests may send to /resolve and /stream (comma list, subdomains included).
# Anything else is refused with 403 before fetching. Unset = the defaults below.
# GUEST_ALLOWED_HOSTS=youtube.com,youtu.be,music.youtube.com,soundcloud.com,bandcamp.com

# Uncomment this block on the public host. Leave it commented for LAN-only or
# desktop use. Every value here is non-secret.
#
# URL phones use, shown in the banner and QR code. server:up fills in the LAN
# URL when this is unset.
# PUBLIC_URL=https://open-record.uttarasoftware.ca
# Trust X-Forwarded-For only from the local cloudflared (loopback). Required behind a proxy: without
# it every client is seen as the proxy's address and per-client limits are shared.
# Never set true on this host: direct LAN clients to 8787 could spoof their address
# and evade rate limits.
# TRUST_PROXY=127.0.0.1
# Opt-in: key per-client limits by CF-Connecting-IP from a loopback peer (cloudflared).
# Set true ONLY when cloudflared is the sole path to the origin (HOST=127.0.0.1, no
# other same-host reverse proxy in front). A proxy that forwards unknown headers
# would let clients pick their own rate-limit bucket. Default false.
# TRUST_CF_CONNECTING_IP=true
# Speakers fetch audio over the LAN, not through the public hostname. Keep HOST
# loopback-only and set CAST_RELAY_PORT: a separate listener then serves ONLY the
# cast relay on the LAN (no API, no login). Open that TCP port to your LAN only.
# Must differ from PORT. Never forward it to the internet.
# CAST_RELAY_PORT=8788
# Interface for the relay listener. Default 0.0.0.0 (all interfaces).
# CAST_RELAY_HOST=0.0.0.0
# Explicit base URL the speaker uses, e.g. http://<lan-ip>:8788. Overrides the
# detected address. Must be http(s), and not loopback, or casting is disabled.
# CAST_MEDIA_BASE_URL=http://<lan-ip>:8788
# Per-user upload cache cap in MB (0-1048576). 0 = PC-browser uploads are off.
# A cap below CAST_UPLOAD_MAX_MB also caps a single upload (the smaller value wins).
# CAST_CACHE_MB=512
# pino log level: trace|debug|info|warn|error|fatal|silent. info in production.
# LOG_LEVEL=info
# Browser origins allowed to call the API: public web app, local web dev, and the
# Capacitor shells. CORS is not authentication; the token/Supabase auth still
# protects the API.
# CORS_ORIGINS=https://open-record.uttarasoftware.ca,http://localhost:4200,capacitor://localhost,http://localhost

# --- Sessions (phone <-> PC sync; requires a Supabase account) -----------------
# Register the session REST routes and the /session websocket.
# SESSION_ENABLED=true
# Drop an idle session room after this many minutes (1-1440).
# SESSION_IDLE_TIMEOUT_MIN=120
# Pause and clear a target after this many minutes with no contact (1-1440).
# SESSION_TARGET_STALE_MIN=30

# --- Cast (Chromecast / Google Home) ------------------------------------------
# Discovery and control (opens mDNS sockets). false = cast devices are not offered.
# CAST_ENABLED=true
# Default speaker base URL: the CAST_RELAY_PORT listener on the detected LAN
# address (the relay listener is what speakers must reach). Without
# CAST_RELAY_PORT it falls back to PUBLIC_URL, else HOST, else the LAN address.
# A loopback URL (127.0.0.1, localhost, ::1) cannot be reached by a speaker, so
# casting is disabled with a warning. Must be http(s).
# Relay token TTL in seconds (60-86400); slides while the cast session is active.
# CAST_RELAY_TTL_SEC=900
# Largest accepted upload in MB (1-4096). Effective limit is min(this, CAST_CACHE_MB).
# CAST_UPLOAD_MAX_MB=200
# Transcode fallback binary: a name on PATH or an absolute path.
# FFMPEG_PATH=ffmpeg

# --- Desktop app (Electron-managed server) -----------------------------------
# The desktop main process sets this so its child server skips the token/pairing
# banner and QR code (the desktop owns and passes the token). Leave unset on the
# public server; do not reuse the desktop token there.
# OPEN_RECORD_QUIET_STARTUP=1

# Optional Supabase Auth: also accept signed-in users' Supabase access tokens
# (rate limits then apply per user). The static token above keeps working.
# Do not put the Supabase database password or a service_role key here.
# Shared-secret projects (HS256): Supabase dashboard > Project Settings > JWT.
# Prefer asymmetric signing keys/JWKS and leave this unset.
# Local stack (`supabase start`): printed as "JWT secret".
# SUPABASE_JWT_SECRET=
# Asymmetric signing keys (ES256/RS256): verified via <SUPABASE_URL>/auth/v1/.well-known/jwks.json.
# SUPABASE_URL=http://127.0.0.1:54321
# Public anon key, served (with SUPABASE_URL) to the web app at GET /app-config
# so it can sign in. Public by design; never put the JWT secret or a
# service_role key here.
# Needs SUPABASE_URL. Local stack: "anon key" from `supabase status`.
# SUPABASE_ANON_KEY=
# Optional YouTube cookies (Netscape cookies.txt). Defaults to
# <OPEN_RECORD_DATA_DIR>/cookies.txt (~/.config/open-record/cookies.txt) when
# that file exists; unset with neither file means no cookies at all.
# Used only as a fallback: every request goes out without cookies first, and a
# video refused for sign-in (age check, bot check, private/members-only) is
# retried once with them, so only those songs run twice (slower).
# An absolute host path here always wins, even when the file is broken.
# Keep it outside the repo and chmod 600. E.g. /home/you/cookies.txt.
# YTDLP_COOKIES_FILE=
# JS runtime yt-dlp uses for YouTube challenges (passed to --js-runtimes).
# YTDLP_JS_RUNTIME=node
